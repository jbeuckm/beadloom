# Cloud accounts (optional). Leave both unset and the app runs local-only.
# From the Neon console: Data API URL of the branch, and the Neon Auth URL.
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.c-2.us-east-2.aws.neon.build/neondb/rest/v1
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth

# Tests / local development: an in-memory fake cloud instead of Neon.
# VITE_CLOUD_FAKE=1
